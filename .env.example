# Postgres (compose publishes on 5433) and Redis (6380)
DATABASE_URL=postgresql://office:office@localhost:5433/office
DATABASE_URL_TEST=postgresql://office:office@localhost:5433/office_test
REDIS_URL=redis://localhost:6380
# API
API_PORT=4000
# API_HOST=127.0.0.1
COOKIE_SECRET=change-me-32-chars-minimum-xxxxxxxxxx
WEB_ORIGIN=http://localhost:3000
OFFICE_DATA_DIR=./data
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
# Worker
OFFICE_API_URL=ws://localhost:4000
OFFICE_WORKER_HOME=~/.office-worker
# Colon-separated roots the worker may run agents under. To run missions on an existing
# repository, add it (or its parent) here in your local .env, e.g. ...:/path/to/repo
OFFICE_WORKSPACE_ROOTS=/home/meren/projects/office-workspaces
OFFICE_RUNTIME=claude
OFFICE_WORKER_CAPACITY=2
# Skills: colon-separated directories local/git skill imports may read from.
# Default: <repo>/templates/skills
# OFFICE_SKILL_IMPORT_ROOTS=
# Messaging limits (defaults 20 / 100 / 2 / 3), reply wait and context pack size
# OFFICE_MSG_PER_SESSION=20
# OFFICE_MSG_PER_TASK=100
# OFFICE_ESCALATION_DEPTH=2
# OFFICE_HANDOFF_CHAIN=3
# OFFICE_REPLY_TIMEOUT_MINUTES=60
# OFFICE_CONTEXT_PACK_MAX_CHARS=12000
# Remote worker container (pnpm worker:remote; compose profile `remote`).
# The container reaches the API at host.docker.internal:4000, so the API must listen on
# API_HOST=0.0.0.0. Enroll token from POST /workers; only needed on first start.
# OFFICE_REMOTE_ENROLL_TOKEN=
# OFFICE_REMOTE_WORKER_NAME=remote-1
# fake (default) or claude; claude needs the owner's Claude credentials inside the container
# OFFICE_REMOTE_RUNTIME=fake
