generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  planned
  ready
  queued
  running
  waiting_reply
  waiting_approval
  review
  done
  failed
  cancelled
  blocked
}

enum RunStatus {
  queued
  running
  waiting_reply
  waiting_approval
  succeeded
  failed
  cancelled
  lost
}

enum RunKind {
  task
  inbox
  plan
  review
  summary
  chat
}

enum ConversationKind {
  direct
  group
  task
  human
}

enum MessageType {
  message
  question
  reply
  handoff
  help_request
  escalation
  artifact
}

enum DeliveryStatus {
  pending
  delivered
  acknowledged
}

enum MemoryType {
  decision
  convention
  api_contract
  known_issue
  lesson
  task_summary
}

enum MemoryScope {
  project
  agent_project
  agent
}

enum MemoryStatus {
  proposed
  verified
  rejected
}

enum MemorySourceKind {
  event
  message
  commit
  file
  run
  task
}

enum WorkerStatus {
  pending
  online
  offline
  revoked
}

model User {
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  email        String        @unique
  passwordHash String
  sessions     UserSession[]
}

model UserSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Project {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  name          String
  slug          String         @unique
  repoPath      String
  defaultBranch String         @default("main")
  tasks         Task[]
  sessions      AgentSession[]
  usage         UsageRecord[]
  runs          TaskRun[]
}

model Agent {
  id               String         @id @default(uuid())
  createdAt        DateTime       @default(now())
  name             String
  slug             String         @unique
  role             String
  description      String         @default("")
  isActive         Boolean        @default(true)
  isSystem         Boolean        @default(false)
  currentVersionId String?
  versions         AgentVersion[]
  tasks            Task[]
  sessions         AgentSession[]
  usage            UsageRecord[]
  runs             TaskRun[]
}

model AgentVersion {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  agentId   String
  version   Int
  config    Json
  agent     Agent           @relation(fields: [agentId], references: [id])
  runs      TaskRun[]
  skills    AgentSkill[]
  subagents AgentSubagent[]

  @@unique([agentId, version])
  @@index([agentId])
}

model Worker {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  name            String
  status          WorkerStatus @default(pending)
  enrollTokenHash String?
  credentialHash  String?
  capacity        Int          @default(1)
  allowedRoots    String[]
  lastHeartbeatAt DateTime?
  runs            TaskRun[]
}

model Task {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  projectId   String
  agentId     String
  title       String
  description String     @default("")
  status      TaskStatus @default(ready)
  priority    Int        @default(0)
  maxAttempts Int        @default(2)
  attempts    Int        @default(0)
  updatedAt   DateTime   @updatedAt
  project     Project    @relation(fields: [projectId], references: [id])
  agent       Agent      @relation(fields: [agentId], references: [id])
  runs        TaskRun[]

  @@index([projectId])
  @@index([agentId])
}

model TaskRun {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now())
  taskId         String?
  agentId        String
  projectId      String
  kind           RunKind       @default(task)
  conversationId String?
  waitingSince   DateTime?
  waitingForMessageId String?
  summaryOfRunId String?
  summarizedAt   DateTime?
  agentVersionId String
  workerId       String?
  status         RunStatus     @default(queued)
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  resultText     String?
  error          String?
  costUsd        Float         @default(0)
  task           Task?         @relation(fields: [taskId], references: [id])
  agent          Agent         @relation(fields: [agentId], references: [id])
  project        Project       @relation(fields: [projectId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  agentVersion   AgentVersion  @relation(fields: [agentVersionId], references: [id])
  worker         Worker?       @relation(fields: [workerId], references: [id])
  session        AgentSession?
  usage          UsageRecord[]

  @@index([taskId])
  @@index([agentId])
  @@index([projectId])
  @@index([conversationId])
  @@index([agentVersionId])
  @@index([workerId])
}

model AgentSession {
  id             String         @id @default(uuid())
  createdAt      DateTime       @default(now())
  runId          String         @unique
  agentId        String
  projectId      String
  sdkSessionId   String?
  model          String
  status         String
  startedAt      DateTime
  endedAt        DateTime?
  skillsSnapshot Json?
  contextPack    Json?
  run            TaskRun        @relation(fields: [runId], references: [id])
  agent          Agent          @relation(fields: [agentId], references: [id])
  project        Project        @relation(fields: [projectId], references: [id])
  events         SessionEvent[]
  subagentRuns   SubagentRun[]

  @@index([agentId])
  @@index([projectId])
}

model SessionEvent {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now())
  sessionId String
  seq       Int
  type      String
  ts        DateTime
  payload   Json
  session   AgentSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
}

model UsageRecord {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  runId        String
  projectId    String
  agentId      String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  run          TaskRun  @relation(fields: [runId], references: [id])
  project      Project  @relation(fields: [projectId], references: [id])
  agent        Agent    @relation(fields: [agentId], references: [id])

  @@index([runId])
  @@index([projectId])
  @@index([agentId])
}

model Skill {
  id               String         @id @default(uuid())
  createdAt        DateTime       @default(now())
  name             String         @unique
  description      String
  source           String
  sourceRef        String?
  status           String         @default("pending_review")
  currentVersionId String?
  versions         SkillVersion[]
  agentSkills      AgentSkill[]
}

model SkillVersion {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  skillId     String
  version     Int
  files       Json
  checksum    String
  createdBy   String       @default("owner")
  skill       Skill        @relation(fields: [skillId], references: [id])
  agentSkills AgentSkill[]

  @@unique([skillId, version])
  @@index([skillId])
}

model AgentSkill {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  agentVersionId String
  skillId        String
  skillVersionId String
  mode           String
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id])
  skill          Skill        @relation(fields: [skillId], references: [id])
  skillVersion   SkillVersion @relation(fields: [skillVersionId], references: [id])

  @@unique([agentVersionId, skillId])
  @@index([agentVersionId])
  @@index([skillId])
  @@index([skillVersionId])
}

model AgentSubagent {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  agentVersionId String
  name           String
  definition     Json
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id])

  @@unique([agentVersionId, name])
  @@index([agentVersionId])
}

model SubagentRun {
  id           String       @id @default(uuid())
  createdAt    DateTime     @default(now())
  sessionId    String
  toolUseId    String       @unique
  subagentType String?
  description  String?
  status       String       @default("running")
  summary      String?
  startedAt    DateTime
  endedAt      DateTime?
  session      AgentSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Conversation {
  id            String           @id @default(uuid())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  projectId     String
  kind          ConversationKind
  title         String
  taskId        String?
  agentIds      String[]
  includesOwner Boolean          @default(false)
  sdkSessionId  String?
  messages      Message[]
  runs          TaskRun[]

  @@index([projectId, updatedAt])
  @@index([taskId])
}

model Message {
  id              String            @id @default(uuid())
  createdAt       DateTime          @default(now())
  conversationId  String
  projectId       String
  type            MessageType
  body            String
  senderAgentId   String?
  senderUserId    String?
  senderSessionId String?
  taskId          String?
  inReplyToId     String?
  awaitingReply   Boolean           @default(false)
  idempotencyKey  String?           @unique
  escalationDepth Int               @default(0)
  handoffChain    Int               @default(0)
  conversation    Conversation      @relation(fields: [conversationId], references: [id])
  deliveries      MessageDelivery[]

  @@index([conversationId, createdAt])
  @@index([projectId, createdAt])
  @@index([inReplyToId])
}

model MessageDelivery {
  id               String         @id @default(uuid())
  createdAt        DateTime       @default(now())
  messageId        String
  recipientAgentId String?
  recipientUserId  String?
  status           DeliveryStatus @default(pending)
  deliveredAt      DateTime?
  acknowledgedAt   DateTime?
  message          Message        @relation(fields: [messageId], references: [id])

  @@unique([messageId, recipientAgentId])
  @@index([recipientAgentId, status])
}

model MemoryEntry {
  id             String                       @id @default(uuid())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  projectId      String?
  agentId        String?
  scope          MemoryScope
  type           MemoryType
  title          String
  content        String
  authorType     String
  authorAgentId  String?
  status         MemoryStatus                 @default(proposed)
  version        Int                          @default(1)
  supersededById String?
  supersededBy   MemoryEntry?                 @relation("Supersedes", fields: [supersededById], references: [id])
  supersedes     MemoryEntry[]                @relation("Supersedes")
  taskId         String?
  runId          String?
  verifiedAt     DateTime?
  embedding      Unsupported("vector(1536)")?
  search         Unsupported("tsvector")?
  sources        MemorySource[]

  @@index([projectId, status, type])
  @@index([agentId])
  @@index([taskId])
}

model MemorySource {
  id            String           @id @default(uuid())
  memoryEntryId String
  kind          MemorySourceKind
  ref           String
  label         String?
  memoryEntry   MemoryEntry      @relation(fields: [memoryEntryId], references: [id])

  @@index([memoryEntryId])
}
